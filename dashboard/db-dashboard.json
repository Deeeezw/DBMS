{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["containers", "cadvisor", "docker"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Container Metrics",
  "uid": "distributed-db-overview",
  "version": 2,
  "panels": [

    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage per Container",
      "description": "Rate of CPU seconds consumed per container over the last minute.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "bargauge",
      "title": "Memory Usage per Container",
      "description": "Current resident memory used by each container.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 134217728 },
              { "color": "red",    "value": 536870912 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "container_memory_usage_bytes{name!=\"\"}",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "type": "timeseries",
      "title": "Network — Receive Bytes/s",
      "description": "Inbound network traffic rate per container.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "Bps",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "type": "timeseries",
      "title": "Network — Transmit Bytes/s",
      "description": "Outbound network traffic rate per container.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "Bps",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity" }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "state-timeline",
      "title": "Shard Online / Offline History",
      "description": "1 = online, 0 = offline. Shows when each shard went down and came back up.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "options": {
        "mergeValues": false,
        "showValue": "never",
        "alignValue": "center",
        "rowHeight": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Offline", "color": "red"   } } },
            { "type": "value", "options": { "1": { "text": "Online",  "color": "green" } } }
          ],
          "custom": { "fillOpacity": 90, "lineWidth": 0, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "shard_online",
          "legendFormat": "{{shard}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Backend Process Uptime",
      "description": "How long the backend Node.js process has been running (from process_start_time_seconds).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 25 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green",  "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "time() - process_start_time_seconds{job=\"backend\"}",
          "legendFormat": "Backend uptime",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Container Running Time",
      "description": "How long each container has been alive (seconds since its start time). Drops to 0 on restart.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 25 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "opacity",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "time() - container_start_time_seconds{name!=\"\", name!~\".*cadvisor.*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Total Rows per Shard — Over Time",
      "description": "How many rows (barang) each shard holds over time. Spikes = inserts, drops = deletes or rebalancing.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 33 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "shard_data_rows_total",
          "legendFormat": "{{shard}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "type": "bargauge",
      "title": "Current Rows per Shard",
      "description": "Snapshot of how many rows each shard holds right now.",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 33 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "valueMode": "color",
        "minVizWidth": 0,
        "minVizHeight": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue",   "value": null },
              { "color": "green",  "value": 1 },
              { "color": "yellow", "value": 500 },
              { "color": "red",    "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
          "expr": "shard_data_rows_total",
          "instant": true,
          "legendFormat": "{{shard}}",
          "refId": "A"
        }
      ]
    }

  ]
}
